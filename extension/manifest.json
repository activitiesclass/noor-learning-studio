{
  "manifest_version": 2,
  "name": "استوديو نور | منتجات رقمية",
  "version": "1.9.2",
  "description": "إضافة Firefox من منتجات رقمية لمساعدة المعلم على اختيار التحضير وتعبئة نموذج نور مع المراجعة اليدوية.",
  "permissions": [
    "storage",
    "https://lms.moe.gov.om/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "استوديو نور | منتجات رقمية"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.moe.gov.om/teacher",
        "https://lms.moe.gov.om/teacher/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "noor-preparations@local.teacher",
      "strict_min_version": "115.0"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
